<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.fureverhome.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/navigation_tasks"
        android:name="com.example.fureverhome.ui.tasks.TasksFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_tasks" />
    <fragment
        android:id="@+id/navigation_events"
        android:name="com.example.fureverhome.ui.events.EventsFragment"
        android:label="Events"
        tools:layout="@layout/fragment_events" />
    <fragment
        android:id="@+id/navigation_community"
        android:name="com.example.fureverhome.ui.community.DiscussionsFragment"
        android:label="Community"
        tools:layout="@layout/fragment_community" />
    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.fureverhome.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboard_to_shelterDashboard"
            app:destination="@id/shelterDashboard" />

        <action
            android:id="@+id/action_dashboard_to_volunteerDashboard"
            app:destination="@id/volunteerDashboard" />
    </fragment>
    <fragment
        android:id="@+id/shelterDashboard"
        android:name="com.example.fureverhome.ui.dashboard.ShelterDashboardFragment"
        android:label="Shelter Dashboard"
        tools:layout="@layout/fragment_shelter_dashboard" />
    <fragment
        android:id="@+id/volunteerDashboard"
        android:name="com.example.fureverhome.ui.dashboard.VolunteerDashboardFragment"
        android:label="Volunteer Dashboard"
        tools:layout="@layout/fragment_volunteer_dashboard" />
</navigation>
