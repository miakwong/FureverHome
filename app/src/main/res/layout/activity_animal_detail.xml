<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Carousel -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/imageCarousel"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="16dp" />

        <!-- Pet Information -->
        <TextView android:id="@+id/name" style="@style/TextAppearance.AppCompat.Large" />
        <TextView android:id="@+id/species" style="@style/TextAppearance.AppCompat.Medium" />
        <TextView android:id="@+id/breed" style="@style/TextAppearance.AppCompat.Medium" />
        <TextView android:id="@+id/size" style="@style/TextAppearance.AppCompat.Medium" />
        <TextView android:id="@+id/age" style="@style/TextAppearance.AppCompat.Medium" />
        <TextView android:id="@+id/gender" style="@style/TextAppearance.AppCompat.Medium" />
        <TextView android:id="@+id/location" style="@style/TextAppearance.AppCompat.Medium" />
        <TextView android:id="@+id/status" style="@style/TextAppearance.AppCompat.Medium" />

        <!-- Description -->
        <TextView
            android:id="@+id/descriptionLabel"
            android:text="Description"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            style="@style/TextAppearance.AppCompat.Medium"/>

        <TextView
            android:id="@+id/description"
            android:layout_marginTop="8dp"
            style="@style/TextAppearance.AppCompat.Body1"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
